# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
arca_notionex-*.tar

# Do not commit .env (for storing API keys, etc)
.env

# Escript build artifact
/notionex

# Per-developer Claude Code settings (paths and tool allowlists vary).
.claude/settings.local.json

# Ignore intent upgrade backups
.backup/backup-*

# AGENTS.md regeneration safety net (intent agents sync writes this; transient).
/AGENTS.md.bak
# Treeindex cache (derived, machine-local; regenerate with 'intent treeindex <dir>').
intent/.treeindex/

# The Intent runtime store: per-machine, rebuilt from the committed extract.
intent/.cache/

# D53: the event log lives in the store; its file form is produced by `intent export`.
intent/events.jsonl
intent/.backup/
